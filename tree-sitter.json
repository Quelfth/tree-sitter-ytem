{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ytem",
      "camelcase": "Ytem",
      "title": "Ytem",
      "scope": "source.ytem",
      "file-types": [
        "ytem"
      ],
      "injection-regex": "^ytem$",
      "class-name": "TreeSitterYtem"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Ytem grammar for tree-sitter",
    "authors": [
      {
        "name": "Quelfth",
        "email": "quelfth@gmail.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/Quelfth/tree-sitter-ytem",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}